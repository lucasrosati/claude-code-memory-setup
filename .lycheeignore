# Patterns ignored by the check-links job (regex, one per line).
# Local / private hosts
^https?://localhost
^https?://127\.0\.0\.1
^https?://0\.0\.0\.0
# RFC 2606 example domains
example\.com
example\.org
example\.net
# Placeholders in documented commands / paths
<vault>
<project>
<repo>
<user>
<nome>
<name>
YOUR-USER
YOUR_USER
your-user
seu-usuario
